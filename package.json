{
  "name": "visual-ai-browser-agent",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:contract": "vitest run tests/contract",
    "build": "turbo run build",
    "secret:scan": "node scripts/secret-scan.mjs",
    "supabase:migration-check": "node scripts/check-supabase-migrations.mjs",
    "supabase:test": "supabase test db"
  },
  "devDependencies": {
    "@eslint/js": "9.22.0",
    "eslint": "9.22.0",
    "prettier": "3.5.3",
    "supabase": "^2.111.0",
    "turbo": "2.4.4",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.0",
    "vitest": "3.0.9"
  }
}
