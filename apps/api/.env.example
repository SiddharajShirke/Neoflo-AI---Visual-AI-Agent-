# Server-only configuration names. Supply real values outside version control.
LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:3000
# Do not use '*' for authenticated routes. Comma-separate only explicit origins.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SECRET_KEY=replace-with-server-only-secret-key
SUPABASE_DB_URL=postgresql://postgres:replace-with-password@db.your-project.supabase.co:5432/postgres
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Server-only; the endpoint is disabled when absent.
INTERNAL_OUTBOX_PUBLISH_TOKEN=replace-with-server-only-internal-token
API_MAX_REQUEST_BYTES=262144
API_MAX_EVENTS_PER_BATCH=100
API_MAX_TITLE_LENGTH=512
API_MAX_REDACTED_CONTEXT_BYTES=12000
API_MAX_FUTURE_TIMESTAMP_SECONDS=300
API_MAX_PAST_TIMESTAMP_SECONDS=86400
OUTBOX_PUBLISH_MAX_BATCH=50
OUTBOX_PUBLISH_MAX_SECONDS=2.0
